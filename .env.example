# Leave unset to use the default local SQLite database (fieldos_dev.db).
# Only set this if you want to point at a different database (e.g. Postgres).
# DATABASE_URL=postgresql+psycopg://user:password@host:5432/dbname

# Optional. Only enables voice-to-DPR (fieldos/sarvam.py) -- this is the one
# feature that needs the internet; everything else runs fully offline.
# Get a key at https://dashboard.sarvam.ai/login
# SARVAM_API_KEY=
