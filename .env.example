# Leave unset to use the default local SQLite database (fieldos_dev.db).
# This is the only supported database -- requirements.txt has no Postgres
# driver, and no code path uses one. FieldOS is SQLite-only by design (it
# ships as an offline desktop app, not a hosted service -- see the
# "Building the desktop app" section below).
# DATABASE_URL=sqlite:///./fieldos_dev.db

# Optional. Only enables voice-to-DPR (fieldos/sarvam.py) -- this is the one
# feature that needs the internet; everything else runs fully offline.
# Get a key at https://dashboard.sarvam.ai/login
# SARVAM_API_KEY=

# Optional. Only enables the billing endpoints (fieldos/routers/billing.py).
# As of this writing nothing in the frontend calls them yet -- leave unset
# unless you're actively developing that feature.
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
