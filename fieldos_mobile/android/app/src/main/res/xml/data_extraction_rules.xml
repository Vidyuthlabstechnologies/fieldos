<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: nothing goes to Google's cloud backup or to a new phone
     by device transfer. The database holds wages, money and the cloud
     sign-in; the in-app backup (Settings > Backup) is the supported way to
     move phones, and it leaves the sign-in out. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
