# Copy to launch-secrets.env (gitignored), fill in, then run
# tools/set_launch_secrets.sh as the repository owner. Leave anything you
# don't have yet empty; it is skipped. Where each value comes from:
# docs/PLAY_STORE_LAUNCH.md sections 1 and 7, and issues #50 and #51.

# --- Supabase (issue #50): Project Settings -> API -----------------------
SUPABASE_URL=                 # https://<ref>.supabase.co
SUPABASE_ANON_KEY=            # the anon / publishable key -- never service_role
SUPABASE_ACCESS_TOKEN=        # sbp_... from supabase.com/dashboard/account/tokens
SUPABASE_DB_PASSWORD=         # chosen when the project was created

# --- RevenueCat (issue #51): project -> API keys, PUBLIC SDK keys ---------
REVENUECAT_ANDROID_KEY=       # goog_...
REVENUECAT_IOS_KEY=           # appl_... (leave empty until the iPhone app exists)
# A SECRET (v1) key, sk_...: lets the AI assistant's server check the plan.
# It never goes in the app; only the ai-assistant edge function gets it.
REVENUECAT_SECRET_KEY=

# --- AI assistant (server side only; see docs/AI_ASSISTANT.md) -----------
ANTHROPIC_API_KEY=            # sk-ant-... from console.anthropic.com -> API keys
SARVAM_API_KEY=               # from dashboard.sarvam.ai; one shared key for every user's voice fallback

# --- Android upload signing: the keystore made on the owner's computer ----
ANDROID_KEYSTORE_FILE=        # path to upload.keystore / .jks; encoded for you
ANDROID_KEYSTORE_BASE64=      # or paste the base64 yourself and leave FILE empty
ANDROID_KEY_ALIAS=
ANDROID_KEY_PASSWORD=
ANDROID_STORE_PASSWORD=
